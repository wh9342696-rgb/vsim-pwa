{
  "name": "VSIM Admin Panel",
  "short_name": "VSIM Admin",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#090D16",
  "theme_color": "#090D16",
  "orientation": "portrait-primary",
  "lang": "en-US",
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "categories": ["business", "productivity"],
  "description": "VSIM operations dashboard for users, payouts, merchants, support, and platform health.",
  "icons": [
    { "src": "/icons/vsim-admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/vsim-admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
