[Unit]
Description=VSIM production Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/vsim
ExecStart=/usr/bin/docker compose --env-file /var/www/vsim/.env.docker up -d
ExecStop=/usr/bin/docker compose --env-file /var/www/vsim/.env.docker stop
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target