PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
FRONTEND_URL=https://your-domain.com
ALLOWED_ORIGINS=https://vsime.uk,https://www.vsime.uk,https://*.pages.dev
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vsim_db
PGUSER=vsim_app
PGPASSWORD=change_this_password
PGSSL=false
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_MS=30000
PGPOOL_CONNECT_MS=5000

# Deployment notes:
# - Use HTTPS only in production.
# - Store real secrets outside version control.
# - Use a managed reverse proxy or TLS termination in front of Node.
