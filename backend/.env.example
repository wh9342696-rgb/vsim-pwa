# Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://vsime.uk
ALLOWED_ORIGINS=https://vsime.uk,https://www.vsime.uk,https://*.pages.dev

# REQUIRED: JWT Secret for authentication (min 32 chars recommended)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_key_here_min_32_chars

# PostgreSQL connection. Use either DATABASE_URL or all five PG variables below.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vsim_db
PGUSER=vsim_app
PGPASSWORD=replace_with_a_secret
# DATABASE_URL=postgresql://vsim_app:replace_with_a_secret@127.0.0.1:5432/vsim_db
# Set true only when your PostgreSQL provider requires TLS.
PGSSL=false
PGPOOL_MAX=20
PGPOOL_MIN=2
PGPOOL_IDLE_MS=30000
PGPOOL_CONNECT_MS=5000
